      "holdMs": 2400
    },
    {
      "target": {
        "classes": [
          "asc-speed-val"
        ]
      },
      "do": "wheel",
      "delta": 1,
      "say": "asc.wiki.play.main.speed",
      "holdMs": 250
    },
    {
      "target": {
        "classes": [
          "asc-speed-val"
        ]
      },
      "do": "wheel",
      "delta": 1,
      "holdMs": 1800
    },
    {
      "target": {
        "classes": [
          "asc-pause"
        ]
      },
      "do": "click",
      "say": "asc.wiki.play.main.pause",
      "holdMs": 1600
