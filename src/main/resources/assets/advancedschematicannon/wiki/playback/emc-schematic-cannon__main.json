    {
      "target": {
        "classes": [
          "asc-owner-face-canvas"
        ]
      },
      "do": "click",
      "say": "asc.wiki.play.main.owner",
      "holdMs": 1700
    },
    {
      "target": {
        "classes": [
          "asc-owner-face-canvas"
        ]
      },
      "do": "click",
      "holdMs": 1200
