          "asc-block-list"
        ],
        "at": [
          0.125,
          0.031
        ]
      },
      "do": "hover",
      "say": "asc.wiki.play.main.list",
      "holdMs": 2200
    },
    {
      "target": {
        "classes": [
          "asc-play"
        ]
      },
      "do": "click",
